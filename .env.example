# Copy to .env on the BACKEND host only. Never commit .env; never put keys in ui/ code.
# Optional: enables language-model answers in the AI Copilot. Without it the Copilot runs in
# deterministic mode and every other module works unchanged.
ANTHROPIC_API_KEY=

# Optional overrides
# FIREWISE_DB=build/firewise.sqlite
# FIREWISE_UI_DIST=ui/dist
# FIREWISE_CORS=http://localhost:5173,http://127.0.0.1:5173
